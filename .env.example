APP_NAME="DOT Enterprise POS & Workshop API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Yangon
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dot_pos
DB_USERNAME=dot_user
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=dot_pos_cache_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

REVERB_APP_ID=dot_pos_app
REVERB_APP_KEY=dot_pos_key_2026
REVERB_APP_SECRET=dot_pos_secret_2026
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Node.js Async Worker Microservice Bridge
NODE_WORKER_URL=http://localhost:3000
NODE_WORKER_SECRET=dot_worker_secret_2026

# Payment Gateway Webhook Cryptographic Secret
PAYMENT_GATEWAY_WEBHOOK_SECRET=dot_enterprise_webhook_secret_key_2026
NODE_WORKER_URL=http://127.0.0.1:3001
